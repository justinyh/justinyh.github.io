{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "personal-website",
	"compatibility_date": "2026-08-02",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "personal-website"
		}
	],
	"r2_buckets": [
		{
			"binding": "NEXT_INC_CACHE_R2_BUCKET",
			"bucket_name": "personal-website-opennext-cache"
		},
		{
			"binding": "R2",
			"bucket_name": "personal-website",
      "preview_bucket_name": "personal-website",
		}
	],
	"d1_databases": [
		{
			"binding": "D1",
			"database_name": "personal-website",
			"database_id": "364a9586-89d5-4082-850a-a482d156deb4",
			"remote": true
		}
	],
	"observability": {
		"enabled": true
	},
	"env": {
		"staging": {
	    "name": "personal-website-staging",
	    "d1_databases": [
			{
				"binding": "D1",
				"database_name": "personal-website-staging",
				"database_id": "ccad8356-5d53-45bf-8bde-fc667362a471",
				"remote": true
			}
	    ],
	    "services": [
	      // The service should match the "name" of your worker
	      {
	        "binding": "WORKER_SELF_REFERENCE",
	        "service": "personal-website-staging"
	      },
	    ],
	    "r2_buckets": [
	      {
	        "binding": "R2",
	        "bucket_name": "personal-website-staging"
	      },
	      // Create a R2 binding with the binding name "NEXT_INC_CACHE_R2_BUCKET"
	      {
	        "binding": "NEXT_INC_CACHE_R2_BUCKET",
	        "bucket_name": "next-cache-staging",
	      },
	    ]
	  }
	}
}